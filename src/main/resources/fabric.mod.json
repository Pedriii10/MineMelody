{
	"schemaVersion": 1,
	"id": "minemelody",
	"version": "${version}",
	"name": "MineMelody",
	"description": "Turn the Minecraft soundtrack into your own playlist. In survival, music discs unlock when you obtain them.",
	"authors": [
		"Pedriii10"
	],
	"contact": {
		"sources": "https://github.com/Pedriii10/MineMelody",
		"issues": "https://github.com/Pedriii10/MineMelody/issues"
	},
	"license": "MIT",
	"icon": "assets/minemelody/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.pedro.minemelody.MineMelodyClient"
		]
	},
	"mixins": [
		"minemelody.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
